<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BXLogger.Serilog</RootNamespace>
    <AssemblyName>BXLogger.Serilog.Sink</AssemblyName>

    <!-- Consumers are ordinary apps, not necessarily on the latest runtime. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>BXLogger.Serilog.Sink</PackageId>
    <Title>BXLogger Serilog Sink</Title>
    <!-- VersionPrefix, not Version: an explicit Version wins outright and would
         make pack.ps1 -VersionSuffix silently do nothing. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Serilog sink that ships structured log events to a BXLogger server over HTTP using CLEF.</Description>
    <PackageTags>serilog;logging;sink;bxlogger;clef;structured-logging</PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md.</PackageReleaseNotes>
    <PackageProjectUrl>$(BXLoggerProjectUrl)</PackageProjectUrl>
    <RepositoryUrl>$(BXLoggerProjectUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Public API, so the XML docs ship: this is the only project that overrides the
         solution-wide GenerateDocumentationFile=false. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Catches a framework-specific asset landing in only some of the three lib/
         folders, which otherwise surfaces as a consumer's missing-method exception. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.PeriodicBatching" />
  </ItemGroup>

  <ItemGroup Label="Package content">
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
