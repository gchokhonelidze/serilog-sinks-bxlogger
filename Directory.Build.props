<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Only the sink itself ships; the test project opts out in its own file. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Package identity">
    <Authors>BXLogger</Authors>
    <Company>BizNetX</Company>
    <Copyright>Copyright (c) BizNetX</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- This repository, which nuget.org links "Project website" and "Source
         repository" at. pack.ps1 refuses to push if this is ever not a real URL. -->
    <BXLoggerProjectUrl>https://github.com/gchokhonelidze/serilog-sinks-bxlogger</BXLoggerProjectUrl>
  </PropertyGroup>

</Project>
